# ============================================================
# La Compagnia del Gluten Free — Regole performance per PRODUZIONE (Keliweb/Apache)
# ------------------------------------------------------------
# Da incollare nel file .htaccess della root WordPress su Keliweb,
# DOPO il blocco "# BEGIN WordPress ... # END WordPress" (non dentro).
# Attacca le voci Lighthouse: "Use efficient cache lifetimes" (~2750ms)
# e migliora il delivery con compressione. Su server LiteSpeed la cache
# pagina la gestisce il plugin LiteSpeed Cache (vedi guida in fondo).
# ============================================================

# ---------- Compressione (GZIP) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/font-woff application/font-woff2 font/woff font/woff2
</IfModule>

# ---------- Compressione (Brotli, se disponibile) ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff2
</IfModule>

# ---------- Caching del browser (Expires) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # Immagini / font: 1 anno (sono versionati o cambiano di rado)
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/gif                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType application/font-woff2   "access plus 1 year"
  # CSS / JS: 1 mese
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType text/javascript          "access plus 1 month"
  # HTML: niente cache lunga (la cache pagina la fa il plugin)
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# ---------- Cache-Control espliciti per asset statici ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Sicurezza leggera (non impatta la performance ma utile al go-live)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================================
# GUIDA SETUP PERFORMANCE KELIWEB (riassunto operativo)
# ------------------------------------------------------------
# 1. CACHE PAGINA:
#    - Se l'hosting e' LiteSpeed (tipico Keliweb) -> installa "LiteSpeed Cache"
#      (gratuito). Attiva: Cache abilitata, Browser Cache, CSS/JS Minify +
#      Combine, "Generate Critical CSS", "Load CSS Asynchronously",
#      "Lazy Load Images", "Image WebP Replacement".
#    - Se NON e' LiteSpeed -> "WP Super Cache" (cache pagina) oppure W3 Total Cache.
# 2. OTTIMIZZAZIONE IMMAGINI (voce Lighthouse ~1850ms):
#    - LiteSpeed Cache include la conversione WebP + ottimizzazione (gratis).
#    - In alternativa: ShortPixel o EWWW Image Optimizer (bulk optimize +
#      WebP/AVIF + resize a max ~1600px).
# 3. FONT: gia' presenti preconnect + display=swap. Opzionale: self-host dei
#    Google Fonts (LiteSpeed ha "Localize Resources") per togliere il dominio
#    esterno dal critical path.
# 4. CDN (opzionale): Cloudflare free davanti al dominio -> CDN + Brotli + cache
#    edge. Migliora TTFB e delivery globale.
# 5. Dopo il setup, ri-misurare con Lighthouse mobile: atteso 85+ (in dev il
#    punteggio e' basso per TTFB del container Coolify, non per il sito).
# ============================================================
